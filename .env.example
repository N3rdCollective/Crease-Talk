# Copy to .env and fill in values:
#   cp .env.example .env

# Supabase — Crease-Talk project
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional client fallback while media_assets catalog is empty
VITE_YOUTUBE_API_KEY=
VITE_YOUTUBE_CHANNEL_HANDLE=creasetalk

# Server-only secrets for Supabase Edge Functions (never prefix with VITE_)
# Set via: supabase secrets set KEY=value --project-ref svtndmrrzjgsyztihyqr
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_HANDLE=creasetalk
# INGEST_CRON_SECRET=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
